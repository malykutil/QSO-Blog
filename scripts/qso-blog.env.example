SOLAR_API_URL=https://ok2mkj.vercel.app
SOLAR_RPI_TOKEN=DOPLN_STEJNY_TOKEN_JAKO_NA_VERCELU
TELEMETRY_INTERVAL_SECONDS=60
RELAY_POLL_INTERVAL_SECONDS=5
RELAY_ACTIVE_LOW=1

# Arduino Nano pres USB. Prazdna hodnota zapne automatickou detekci.
ARDUINO_SERIAL_PORT=
ARDUINO_SERIAL_BAUD=115200
ARDUINO_READ_TIMEOUT_SECONDS=6

# Doplňková MQ-9 ochrana. Tři kritické 2s vzorky alarm trvale zalatchují.
MQ9_ALARM_ENABLED=1
MQ9_CRITICAL_RAW=833
MQ9_ALARM_CONSECUTIVE_SAMPLES=3
MQ9_ALARM_LATCH_FILE=/home/ft-891/mq9-alarm-latched.json

# Waveshare UPS HAT (produkt 18306), INA219 na I2C 0x42.
UPS_HAT_ENABLED=1
UPS_HAT_I2C_BUS=1
UPS_HAT_I2C_ADDRESS=0x42

# Relay outputs, BCM numbering
RELAY_SOLAR1_GPIO=5
RELAY_SOLAR2_GPIO=6
RELAY_BATTERY_GPIO=13
RELAY_BUFIK_GPIO=16
RELAY_FAN12V_GPIO=19
RELAY_FAN24V_GPIO=20
