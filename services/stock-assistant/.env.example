# Aplikace podporuje výhradně PAPER režim. Jiná hodnota zastaví start.
TRADING_MODE=paper
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Volitelné. Bez obou hodnot se Telegram pouze zaloguje jako vypnutý.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Relativní cesty fungují při lokálním spuštění. Docker Compose je přepíše na /app/data.
DATABASE_PATH=data/stock_assistant.db
UNIVERSE_CACHE_PATH=data/universe.json
EUROPE_UNIVERSE_CACHE_PATH=data/europe_universe.json
LOG_LEVEL=INFO
LOG_PATH=logs/assistant.log
INITIAL_CASH=100000
AGENT_INITIAL_CASH=1000
AGENT_EUROPE_INITIAL_CASH=1000
AGENT_RISK_PER_TRADE=0.005
AGENT_MAX_PORTFOLIO_RISK=0.02
AGENT_MAX_POSITIONS=5
AGENT_MAX_SYMBOL_EXPOSURE=0.10
AGENT_MIN_SCORE=75
AGENT_LEARNING_RATE=0.12
AGENT_HIGH_VOLATILITY_RISK_PER_TRADE=0.01
AGENT_HIGH_VOLATILITY_MAX_PORTFOLIO_RISK=0.05
AGENT_HIGH_VOLATILITY_MAX_POSITIONS=8
AGENT_HIGH_VOLATILITY_MAX_SYMBOL_EXPOSURE=0.10
AGENT_HIGH_VOLATILITY_MIN_ATR_PERCENT=1.5
AGENT_HIGH_VOLATILITY_MIN_SCORE=68
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
# Povinné při DASHBOARD_HOST=0.0.0.0. Použijte náhodný řetězec alespoň 32 znaků.
DASHBOARD_API_TOKEN=
# Povolené originy pro lokální browser bridge, oddělené čárkou.
DASHBOARD_CORS_ORIGINS=https://ok2mkj.vercel.app,http://localhost:3000,http://127.0.0.1:3000
MAX_RISK_PER_TRADE=0.01
MIN_RISK_REWARD=2.5
MAX_LLM_CANDIDATES=15
MAX_QUOTE_AGE_MINUTES=15
# Bezplatný evropský Yahoo feed bývá opožděný přibližně 15–20 minut.
EUROPE_MAX_QUOTE_AGE_MINUTES=30
MARKET_DATA_BATCH_SIZE=50
MARKET_DATA_PERIOD=10d
MARKET_DATA_INTERVAL=5m
UNIVERSE_CACHE_HOURS=24
POSITION_UPDATE_THRESHOLD=0.005
TELEGRAM_POLL_SECONDS=10
NEWS_ENABLED=true
NEWS_POLL_MINUTES=5
NEWS_MAX_AGE_HOURS=24
NEWS_MAX_PER_QUERY=10
NEWS_ALERT_SCORE_THRESHOLD=2
NEWS_BOOTSTRAP_ALERTS=1
NEWS_MAX_ALERTS_PER_CYCLE=3
NEWS_GLOBAL_QUERY=NASDAQ OR "S&P 500" stock market when:1d
RUN_OUTSIDE_MARKET_HOURS=false

# Pro lokální smoke test lze omezit universe, např. AAPL,MSFT,NVDA.
# V produkčním běhu nechte prázdné: načte se NASDAQ-100 + S&P 500.
UNIVERSE_OVERRIDE=
# Volitelný lokální test evropské ligy, například ADS.DE,SAN.PA,ASML.AS.
EUROPE_UNIVERSE_OVERRIDE=
